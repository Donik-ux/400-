# ── Groq (AI trip plans, price commentary) ─────────────────────────────
# Get a free key at https://console.groq.com/keys — no card required.
# SERVER-side only — NO VITE_ prefix. Vite bundles anything prefixed VITE_
# straight into the public JS, so a VITE_ key is readable by any visitor via
# devtools. This one is only ever read by api/aiAsk.js.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Public feature flag (not a secret) — set true once GROQ_API_KEY is
# configured, so the client knows it's safe to attempt AI calls.
VITE_AI_ENABLED=false

# ── SerpApi / Google Flights ───────────────────────────────────────────
# Free tier: 250 searches/month, no card — https://serpapi.com/users/sign_up
# FLIGHTS ONLY. Powers api/flightsSerp.js: Google Flights returns the fare a
# traveler would actually see, with the operating airline, real departure times
# and the layover count — the only source here that does. api/flights.js queries
# it on every /flights search alongside Kiwi/Travelpayouts/Duffel/Amadeus, so
# the results list shows a Google fare next to a Kiwi one instead of whichever
# source answered first, and the AI trip planner spends one search per plan on
# the round-trip fare.
# Budget: each distinct route+date costs 1 search (cached 3h), so the free
# 250/month is roughly 250 fresh route searches. Google Hotels is deliberately
# NOT wired to this key — see SERPAPI_HOTELS_KEY below.
# Without this key the flights page falls back to the Kiwi/Amadeus cascade and
# the planner keeps its estimate — nothing breaks.
# SERVER-side only — NO VITE_ prefix.
SERPAPI_KEY=

# ── SerpApi / Google Hotels (OPTIONAL, off by default) ─────────────────
# Separate variable on purpose: hotel searches share no budget with flights.
# api/hotelsSerp.js asks Google Hotels for real, priced properties in the
# district the itinerary spends time in and ranks them by actual walking
# distance to the planned attractions — Amadeus (AMADEUS_* above) returns
# bookable offers but no coordinates, so it cannot answer "which hotel is
# closest to the sights".
# Cost when enabled: 2 searches per generated plan — 1 hotel search plus 1
# details lookup (the ONLY place Google Hotels exposes a street address).
# Leave EMPTY to keep the whole SerpApi quota on flights: the endpoint then
# answers 501, the planner keeps its own hotel suggestion and TourDetail falls
# back to Amadeus prices. Set it to a second SerpApi account's key, or to the
# same key as SERPAPI_KEY if you accept the shared 250/month budget.
# SERVER-side only — NO VITE_ prefix.
SERPAPI_HOTELS_KEY=

# ── Amadeus Self-Service API (real flight + hotel data via GDS) ────────
# Sign up FREE at https://developers.amadeus.com/  →  Create app  →  copy keys.
# Free tier: 2000 flight searches/month, real prices from Skyscanner-grade data.
# The SAME two keys also power api/hotels.js (Hotel Search v3) — no separate
# signup needed for real hotel prices on TourDetail.jsx.
# These are SERVER-side keys — NO VITE_ prefix.  Set them in Vercel project
# settings → Environment Variables (or in this .env for local dev).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Set to "production" only after upgrading to a paid Amadeus production app.
AMADEUS_ENV=test

# ── Travelpayouts / Aviasales (real prices, ANY route, free) ───────────
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# ── MapTiler (map labels in the interface language) ────────────────────
# Free tier, no card: https://cloud.maptiler.com/account/keys/
# OpenStreetMap's tiles only ever carry local-language labels — Cyrillic across
# Russia, Arabic across Egypt — so a visitor reading the site in Spanish gets a
# map they cannot read. MapTiler serves the same data with a `language`
# parameter (src/config/mapTiles.js), which is the only part of a raster map
# that can be translated; the rest is drawn into the image.
# Without this key both maps fall back to OpenStreetMap and keep local labels —
# nothing breaks, the map just stops following the language picker.
#
# This one IS public, unlike every other key here: tile URLs are fetched by the
# browser, so no server can hold it. Restrict it to your domains under
# Keys → allowed origins in the MapTiler dashboard — that, not secrecy, is what
# protects the quota.
VITE_MAPTILER_KEY=

# ── Unsplash (live destination photos, api/photo.js) ────────────────────
# Free key, no card: https://unsplash.com/developers → New Application → Access Key.
# SERVER-side only — NO VITE_ prefix.
UNSPLASH_ACCESS_KEY=

# ── Upstash Redis (public site reviews, api/reviews.js) ──────────────────
# Free, no card: https://upstash.com → Create Database → REST API section.
# SERVER-side only — NO VITE_ prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Duffel (real flight offers, free self-serve test mode) ─────────────
# Sign up FREE at https://app.duffel.com/join — a `duffel_test_...` API key is
# issued instantly, no approval/business-review step. Test keys return
# realistic offers from Duffel's sandbox airlines (not live inventory), which
# is enough for real comparative pricing. SERVER-side only — NO VITE_ prefix.
DUFFEL_API_KEY=


# ── Admin login (src/pages/admin), verified server-side by api/adminAuth.js ──
# Pick a real password — this used to be hardcoded in the client bundle.
ADMIN_PASSWORD=
# Random signing secret for admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Do not reuse across environments; do not commit the real value.
ADMIN_TOKEN_SECRET=
